{
  "name": "tagwise-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Tagwise documentation site (Fumadocs). Built from docs/ and the backend OpenAPI document.",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "openapi": "node scripts/fetch-openapi.mjs --from-source",
    "predev": "node scripts/sync-content.mjs",
    "prebuild": "node scripts/sync-content.mjs",
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "^16.15.10",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "^16.15.10",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
