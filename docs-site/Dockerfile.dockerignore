# BuildKit reads this file for docs-site/Dockerfile. Compose builds it with the
# repository root as context, so docs-site/.dockerignore does not apply.
# Send only the docs site, the Markdown it publishes, the app's theme tokens
# and screenshots; never dependencies, build output, secrets or git history.
*
!docs-site/
!docs/
!README.md
!ARCHITECTURE.md
!PROVENANCE.md
!src/theme/tokens.css
!public/screens/
docs-site/node_modules
docs-site/.next
docs-site/.source
docs-site/out
docs-site/**/*.log
docs-site/.env*
